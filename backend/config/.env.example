# Copy this file to config/.env and fill in your own values.
PORT=4000
NODE_ENV=development

# Local MongoDB, or your own Atlas URI: mongodb+srv://<user>:<password>@<cluster>/hospital_mis
MONGO_URI=mongodb://127.0.0.1:27017/hospital_mis

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=change-me
JWT_EXPIRES=7d
COOKIE_EXPIRES=7

# Browser origins allowed to call the API (patient site and admin dashboard)
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174

# Your Cloudinary account (needed only for uploading doctor photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET_KEY=

# Consultation fee in INR, same for every doctor and department
CONSULTATION_FEE=500

# Admin logins expire after this many hours (the same admin can be logged in on several PCs)
ADMIN_SESSION_HOURS=8

# Hospital time zone (dates, "today", time slots). Keep this on the server too.
TZ=Asia/Kolkata
