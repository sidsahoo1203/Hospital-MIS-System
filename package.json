{
  "name": "hospital-mis-system",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend && npm install --prefix dashboard",
    "dev": "concurrently -n api,site,admin -c blue,green,magenta \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:dashboard\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:dashboard": "npm run dev --prefix dashboard",
    "create-admin": "npm run create-admin --prefix backend --",
    "set-admin-password": "npm run set-admin-password --prefix backend --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
